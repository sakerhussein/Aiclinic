# Copy to .env (never commit .env).

# Direct Postgres connection to the booking project (qwnujxelgzmzoblrenkk).
# Supabase > Connect > "Session pooler" connection string, with the database password.
DATABASE_URL=

# Claude (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=
# Optional: the model and effort the agent uses (defaults shown).
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# ---- WhatsApp Cloud API (step 5) - from your Meta app (developers.facebook.com) ----
# A permanent token from a System User with whatsapp_business_messaging permission.
WA_TOKEN=
# App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WA_APP_SECRET=
# Any long random text; paste the same text in the Meta webhook settings as the "Verify token".
WA_VERIFY_TOKEN=
# WA_GRAPH_VERSION=v23.0
# Each clinic's WhatsApp "Phone number ID" goes in the database: clinics.wa_phone_number_id.

# ---- Reminders (step 6) ----
# Name of the approved message template (Arabic and English versions), see agent/README.md.
# WA_REMINDER_TEMPLATE=appointment_reminder
# REMINDERS_ENABLED=true

# ---- "Find my booking" on the online booking page (migration 0013) ----
# Name of the approved template that carries a new private link: {{1}} clinic, {{2}} when, {{3}} doctor, {{4}} link.
# Its text is the clinic's Settings > Online booking > Find my booking message.
# WA_LINK_TEMPLATE=booking_link
# The online booking page's address, for the links it sends.
# BOOK_SITE_URL=https://book.limitsiz.si

# ---- Staff screen and alerts (step 7) ----
# Password for https://<agent address>/staff (user name: staff). Use a long one.
STAFF_PASSWORD=
# Public address of this service, used in alert emails.
AGENT_BASE_URL=https://agent.limitsiz.si
# Hand-off alerts by email (same Gmail SMTP settings as the website). A clinic's own
# clinics.staff_alert_email wins over STAFF_ALERT_EMAIL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_FROM=
# STAFF_ALERT_EMAIL=

# Where the service listens (behind Nginx).
# AGENT_HOST=127.0.0.1
# AGENT_PORT=3002

# Tests only: a throwaway Postgres server. The tests create and drop a database called booking_test on it.
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/postgres
