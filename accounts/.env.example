# Limitsiz Clinic Accounts: settings. Copy to .env on the server (never commit .env).

PORT=3003
# The public address of this service (https in production; the cookie and the Origin check depend on it).
SITE_URL=https://accounts.limitsiz.si
TRUST_PROXY=1

# The `accounts_app` database login (least privilege). The owner sets its password in Supabase and puts it here.
DATABASE_URL=postgresql://accounts_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 32 random bytes, base64. Encrypts the stored two-step secrets. Losing it means everyone sets up two-step again.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_KEY=

# Email for invitations and password resets (the same mailbox the website uses is fine).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Limitsiz Clinic <no-reply@limitsiz.si>"

# Development only: show invitation and reset links in the API answer.
EXPOSE_LINKS=false
