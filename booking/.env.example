# Limitsiz Clinic Booking: settings. Copy to .env on the server (never commit .env).

PORT=3004
# The public address of this service (https in production).
SITE_URL=https://booking.limitsiz.si
TRUST_PROXY=1

# The `booking_app` database login (least privilege: no deletes, no access to the accounts schema).
DATABASE_URL=postgresql://booking_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# The `audit_reader` login, for the History of a booking. Optional: without it History is empty.
AUDIT_DATABASE_URL=

# Accounts: the public address (the browser is sent there to sign in) and the local one (this server asks it about every session).
ACCOUNTS_URL=https://accounts.limitsiz.si
ACCOUNTS_INTERNAL_URL=http://127.0.0.1:3003
# A long random secret. Accounts keeps only its SHA-256 (accounts.apps.secret_hash for 'booking').
BOOKING_CLIENT_SECRET=
