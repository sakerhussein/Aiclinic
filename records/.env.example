# Limitsiz Clinic Records: settings. deploy/setup-records.sh writes the real .env on the server (never commit .env).

PORT=3006
# The public address of this service (https in production).
SITE_URL=https://records.limitsiz.si
TRUST_PROXY=1

# The `records_app` database login (migration 0020): its own tables, and only the columns of Booking's it needs.
DATABASE_URL=postgresql://records_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Accounts: the public address (the browser is sent there to sign in) and the local one (this server asks it about every session).
ACCOUNTS_URL=https://accounts.limitsiz.si
ACCOUNTS_INTERNAL_URL=http://127.0.0.1:3003
# A long random secret. Accounts keeps only its SHA-256 (accounts.apps.secret_hash for 'records').
RECORDS_CLIENT_SECRET=

# Booking's public address, for the "Open in Booking" links.
BOOKING_URL=https://booking.limitsiz.si

# Photos and documents (phase B). deploy/setup-records-files.sh sets these. Until then uploads are refused ("off").
# STORAGE=supabase: the private bucket, reached only from this server with the project's secret (service) key.
# STORAGE=disk with FILES_DIR: a local folder, for testing only.
STORAGE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=records

# The nightly encrypted backup on the VPS disk: the folder and its 32-byte key file (made on the VPS, never shown).
BACKUP_DIR=/root/records-backup
BACKUP_KEY_FILE=/root/records-backup/backup.key

# Failure emails for the backup (the setup script copies Booking's settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
