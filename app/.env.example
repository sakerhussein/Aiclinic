# Copy this file to .env and fill in your values. Never commit .env.

# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://ivefyhpkmytzbynptkam.supabase.co

# Publishable key. Safe for the browser, but this server uses it too.
# Row Level Security allows it to insert leads only.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JclCayA2UeFei4j1LuaK6A_NVdNHpAb

# Table that stores demo requests
LEADS_TABLE=leads

# Port for the Node.js server
PORT=3001

# Set to 1 when the server runs behind a proxy (Nginx, Render, Railway, etc.)
# so rate limiting sees the real visitor IP.
# TRUST_PROXY=1

# Public address of the site, used in Google tags, link previews and the sitemap.
SITE_URL=https://limitsiz.si

# ---- Lead alerts: an email for every request (recommended) ----
# Any SMTP mailbox works. Gmail: turn on 2-step verification, create an
# "App password" (Google Account > Security > App passwords) and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL_TO=you@gmail.com
# ALERT_EMAIL_FROM=Limitsiz Leads <you@gmail.com>

# ---- Lead alerts: WhatsApp message to your own phone (optional) ----
# Free service CallMeBot (callmebot.com): send "I allow callmebot to send me messages"
# to their WhatsApp number to get your API key. Only a short summary is sent
# (name and how to contact them), never the full message.
# CALLMEBOT_PHONE=9627XXXXXXXX
# CALLMEBOT_APIKEY=123456

# ---- Google Search Console (optional) ----
# Choose "HTML tag" verification and paste only the content="..." value here.
# GOOGLE_SITE_VERIFICATION=

# ---- Visitor stats without cookies (optional, pick one) ----
# Umami Cloud (free plan): paste the Website ID.
# UMAMI_WEBSITE_ID=
# UMAMI_SRC=https://cloud.umami.is/script.js
# Or Plausible (paid): your domain.
# PLAUSIBLE_DOMAIN=limitsiz.si
